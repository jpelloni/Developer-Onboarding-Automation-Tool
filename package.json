{
  "name": "Developer Onboarding Automation Tool",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "node scripts/generate-commands.mjs && tsx src/index.ts",
    "build": "node scripts/generate-commands.mjs && tsc",
    "start": "node dist/index.js",
    "test": "node scripts/generate-commands.mjs && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.mjs",
    "test:coverage": "node scripts/generate-commands.mjs && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.mjs --coverage",
    "test:pr": "node scripts/generate-commands.mjs && COVERAGE_THRESHOLD=0 node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.mjs --coverage --coverageReporters=text --coverageReporters=json-summary",
    "check:pr": "node scripts/check-pr.mjs",
    "generate:commands": "node scripts/generate-commands.mjs",
    "lint": "eslint src",
    "compile:win": "node scripts/generate-commands.mjs && deno compile --allow-sys --allow-read --allow-env --allow-run --target x86_64-pc-windows-msvc --sloppy-imports --output ./out/win/dev-setup.exe ./src/index.ts",
    "compile:linux": "node scripts/generate-commands.mjs && deno compile --allow-sys --allow-read --allow-env --allow-run --target x86_64-unknown-linux-gnu --sloppy-imports --output ./out/linux/dev-setup ./src/index.ts",
    "compile:mac": "node scripts/generate-commands.mjs && deno compile --allow-sys --allow-read --allow-env --allow-run --target x86_64-apple-darwin --sloppy-imports --output ./out/mac/dev-setup ./src/index.ts",
    "compile": "pnpm run compile:win && pnpm run compile:linux && pnpm run compile:mac"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.71.0"
  }
}
